# Copy to .env and fill in. .env is git-ignored and never enters the image.

# Hugging Face token: Colab notebooks and publishing only. Serving needs none.
HF_TOKEN=

# Groq key: offline dataset annotation in Colab, and the LLM fallback when Bedrock is unavailable.
GROQ_API_KEY=

# Local API settings
ORATIO_ENABLE_SPIKE=0
ORATIO_CORS_ORIGINS=["http://localhost:5173"]
ORATIO_BEDROCK_REGION=ap-south-1
